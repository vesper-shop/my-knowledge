{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-knowledge",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "knowledge.you-find.me",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_BUCKET",
      "bucket_name": "cherry-studio",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KNOWLEDGE_CACHE",
      "id": "dc4f4d89276e40d2a82479cfc7867b5d",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTICLE_WRITER",
        "class_name": "ArticleWriter"
      }
    ]
  },
  "exports": {
    "ApiKeyDurableObject": {
      "type": "durable-object",
      "state": "deleted"
    },
    "ArticleWriter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "secrets": { "required": ["VESPER_TOKEN"] },
  "vars": {
    "SITE_URL": "https://knowledge.you-find.me"
  }
}
