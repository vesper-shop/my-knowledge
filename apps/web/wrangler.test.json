{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTICLE_WRITER",
        "class_name": "ArticleWriter"
      }
    ]
  },
  "exports": {
    "ArticleWriter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "name": "my-knowledge-test",
  "r2_buckets": [
    {
      "binding": "KNOWLEDGE_BUCKET",
      "bucket_name": "my-knowledge-test",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KNOWLEDGE_CACHE",
      "id": "00000000000000000000000000000001",
      "remote": false
    }
  ],
  "vars": {
    "SITE_URL": "http://127.0.0.1:8787"
  }
}
