{
  "name": "@my-knowledge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm types && vp build",
    "build:test": "pnpm types && vp build --mode test",
    "preview": "pnpm build && vp preview",
    "seed:local": "node __test__/scripts/seed-local.ts",
    "test:mcp": "node __test__/scripts/mcp-contract.ts http://localhost:8787/api/mcp",
    "dry-run": "wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types node_modules/.wrangler-types.d.ts --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@milkdown/kit": "7.23.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@my-knowledge/content": "workspace:*",
    "@my-knowledge/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "hast-util-from-html": "2.1.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-tweet": "3.3.1",
    "workers-og": "0.0.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "wrangler": "4.165.0"
  }
}
